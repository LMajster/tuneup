{
  "expo": {
    "name": "Tuneup",
    "slug": "tuneup",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1117"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tuneup.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "vnd.youtube",
          "youtubemusic",
          "youtube"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1117"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.tuneup.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "b8d31838-d6d2-431d-a454-2b2faf8b3d4e"
      }
    },
    "owner": "lmaj"
  }
}
